#!/bin/zsh
# Removes the time measurement inserted by 'measurec' from a C file.
# Usage: unmeasurec <file.c>

# Validate the argument.
if [[ $# -ne 1 || ! -f $1 ]]; then
    print -u2 "Usage: unmeasurec <file.c>"
    exit 1
fi

# Keeps every line that doesn't end with '// measurec'.
content=$(awk '!/\/\/ measurec$/' $1) || exit 1

# Writes into the existing file (instead of replacing it), so permissions and attributes are kept.
print -r -- "$content" > $1
